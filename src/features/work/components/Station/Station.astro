---
import { getCollection, getEntry } from 'astro:content';
import { localizedPath, useTranslations, type Locale } from '../../../../i18n';
import { Icon } from '../../../../shared/components/Icon';
import { Socials } from '../../../../shared/components/Socials';
import { PixelIcon } from '../../../../shared/components/PixelIcon';
import type { PixelIconName } from '../../../../shared/components/PixelIcon/PixelIcon.constants';
import { EMAIL } from '../../../../shared/constants';
import { cx } from '../../../../shared/utils/cx';
import { formatSpan } from '../../../../shared/utils/dates';
import { neighbors } from '../../utils/stops';
import { splitLast } from '../../utils/words';
import { Screen } from '../Screen';
import { Stops } from '../Stops';
import { Transcript } from '../Transcript';
import styles from './Station.module.css';

interface Props {
    locale: Locale;
    id: string;
}

const { locale, id } = Astro.props;
const t = useTranslations(locale);
const station = (await getEntry('stations', id))!.data;
const work = (await getEntry('work', id))!.data;
const span = formatSpan(station, locale, { now: t('map.now'), since: t('map.since') });

// Previous and next walk the map's order, through the stations that already have a page.
const built = new Set((await getCollection('work')).map((entry) => entry.id));
const withPages = (await getCollection('stations'))
    .filter((entry) => built.has(entry.id))
    .map((entry) => ({ id: entry.id, ...entry.data }));
const { previous, next } = neighbors(withPages, id);
const stop = (other: (typeof withPages)[number]) => ({
    name: other.name[locale],
    href: localizedPath(locale, `/work/${other.id}/`),
    icon: other.line as PixelIconName,
    line: other.line
});
// The run ends at Contact: the last station's next stop is an email.
const contact = { name: t('map.contact'), href: `mailto:${EMAIL}`, icon: 'boss' as const, line: 'contact' };

// The arrow travels with a link's last word, so a wrapped link never leaves it alone on a line.
const links = work.links.map((link) => ({ ...link, ...splitLast(link.label) }));

// Sections, in reading order. "What went right" only exists where the hard part turned into something good.
const sections = [
    { key: 'features', title: t('work.features') },
    { key: 'problem', title: t('work.problem') },
    { key: 'decisions', title: t('work.decisions') },
    { key: 'proof', title: t('work.proof') },
    { key: 'hard', title: t('work.hard') },
    ...(work.win ? [{ key: 'win', title: t('work.win') } as const] : []),
    { key: 'now', title: t('work.now') }
] as const;
---

<article class={cx(styles, 'station', `line-${station.line}`)}>
    <!-- The node itself, with my road running down the page from it. -->
    <div class={styles.start} aria-hidden="true">
        <span class={styles.tile}><PixelIcon name={station.line as PixelIconName} /></span>
        <span class={styles.road}></span>
    </div>

    <div class={styles.body}>
        <a class={cx(styles, 'back')} href={localizedPath(locale, `/#${id}`)}>
            <span class={styles.backIcon} aria-hidden="true"><PixelIcon name="back" /></span>
            <span class="meta">{t('work.back')}</span>
        </a>

        <!-- The name stays small; what I did, in my own words, is the loudest line on the page. -->
        <header class={styles.header}>
            <div class={styles.who}>
                <h1 class={styles.name}>{station.name[locale]}</h1>
                <p class="meta">{span}</p>
                {station.ongoing && <p class={styles.tag}>{t('map.inProgress')}</p>}
            </div>
            <p class={styles.headline}>{work.headline[locale]}</p>
            <p class={styles.owned}>{work.owned[locale]}</p>
            {
                work.links.length > 0 && (
                    <ul class={`meta ${styles.links}`} aria-label={t('work.links')}>
                        {links.map((link) => (
                            <li>
                                <a href={link.href} rel="noopener" target="_blank">
                                    {link.lead}
                                    <span class={styles.tail}>
                                        {link.last}
                                        <Icon name="arrowOutward" class={styles.out} />
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </header>

        {
            sections.map((section) => (
                    <section class={cx(styles, 'section', section.key === 'win' && 'win', section.key === 'proof' && 'stage')} aria-labelledby={`${section.key}-title`}>
                        <div class={styles.side}>
                            <h2 class={styles.checkpoint} id={`${section.key}-title`}>
                                {section.title}
                            </h2>
                        </div>

                        <div class={styles.answer}>
                            {work.punchline?.section === section.key && <p class={styles.punchline}>{work.punchline.text[locale]}</p>}

                            {section.key === 'features' && (
                                <ul class={styles.features}>
                                    {work.features.map((feature) => (
                                        <li>{feature[locale]}</li>
                                    ))}
                                </ul>
                            )}

                            {section.key === 'problem' && work.problem.map((paragraph) => <p>{paragraph[locale]}</p>)}

                            {section.key === 'decisions' && (
                                <ul class={styles.decisions}>
                                    {work.decisions.map((decision) => (
                                        <li>
                                            <h3 class={styles.decision}>{decision.title[locale]}</h3>
                                            <p>{decision.why[locale]}</p>
                                        </li>
                                    ))}
                                </ul>
                            )}

                            {section.key === 'proof' &&
                                (work.proof.kind === 'transcript' ? (
                                    <Transcript lines={work.proof.lines} caption={work.proof.caption[locale]} label={t('work.transcript')} />
                                ) : (
                                    <Screen
                                        line={station.line as PixelIconName}
                                        source={work.proof.source}
                                        src={work.proof.src}
                                        video={work.proof.video}
                                        alt={work.proof.alt[locale]}
                                        caption={work.proof.caption[locale]}
                                        ratio={work.proof.ratio}
                                        replay={t('work.replay')}
                                        seek={t('work.seek')}
                                        loading={t('work.loading')}
                                        pending={t('work.mediaPending')}
                                    />
                                ))}

                            {section.key === 'hard' && work.hard.map((paragraph) => <p>{paragraph[locale]}</p>)}

                            {section.key === 'win' && work.win?.map((paragraph) => <p>{paragraph[locale]}</p>)}

                            {section.key === 'now' && <p>{work.now[locale]}</p>}
                        </div>
                    </section>
            ))
        }

        <div class={styles.end}>
            <Stops
                label={t('work.stops')}
                previous={previous && { ...stop(previous), caption: t('work.prev') }}
                next={{ ...(next ? stop(next) : contact), caption: t('work.next') }}
            />
        </div>
    </div>

    <script>
        import '../../../../shared/scripts/loop';
    </script>

    <!-- After the road ends: how to reach me, for anyone who landed here first. -->
    <footer class={styles.footer}>
        <Socials label={t('footer.socials')} />
    </footer>
</article>
