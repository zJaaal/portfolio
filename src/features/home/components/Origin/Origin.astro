---
import { useTranslations, type Locale } from '../../../../i18n';
import styles from './Origin.module.css';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class={styles.origin}>
    <div class={styles.start}>
        <div class={styles.portrait}>
            <img src="/portrait.png" width="40" height="40" alt="Jalinson Diaz" />
        </div>
        <div class={styles.stem} aria-hidden="true"></div>
    </div>

    <div class={styles.intro}>
        <h1 class={styles.name}>Jalinson Diaz</h1>
        <p class={styles.role}>{t('intro.role')}</p>
        <p class={styles.bio}>{t('intro.bio')}</p>
    </div>
</div>
