---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../../../../i18n';
import { cx } from '../../../../shared/utils/cx';
import { splitMentions } from '../../utils/mentions';
import { Key } from '../Key';
import styles from './Origin.module.css';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const entries = await getCollection('stations');
// "Now" names the stations in progress; each name links to its node on the map, in its line's color.
const now = splitMentions(
    t('intro.now'),
    entries.filter(({ data }) => data.ongoing).map(({ id, data }) => ({ id, name: data.name[locale], line: data.line }))
);
---

<div class={styles.origin}>
    <div class={styles.start}>
        <div class={styles.portrait}>
            <img src="/portrait.png" width="40" height="40" alt="Jalinson Diaz" />
        </div>
        <div class={styles.stem} aria-hidden="true"></div>
    </div>

    <div class={styles.intro}>
        <h1 class={styles.name}>Jalinson Diaz</h1>
        <p class={styles.role}>{t('intro.role')}</p>
        <p class={styles.bio}>{t('intro.bio')}</p>
        <p class={styles.now}>
            {
                now.map((part) =>
                    part.id ? (
                        <a class={cx(styles, 'mention', `line-${part.line}`)} href={`#${part.id}`}>{part.text}</a>
                    ) : (
                        part.text
                    )
                )
            }
        </p>
    </div>

    <div class={styles.key}>
        <Key locale={locale} />
    </div>
</div>

<script>
    import '../../../../shared/scripts/jump';
</script>
