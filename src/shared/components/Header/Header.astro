---
import { LOCALES, localizedPath, useTranslations, type Locale } from '../../../i18n';
import { Icon } from '../Icon';
import styles from './Header.module.css';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<header class={`wrap ${styles.header}`}>
    <a class={styles.home} href={localizedPath(locale)}>{t('header.home')}</a>
    <div class={styles.controls}>
        <nav class={styles.lang} aria-label={t('header.language')} data-current={locale}>
            <a
                href={localizedPath('en')}
                hreflang="en"
                lang="en"
                data-locale-link
                aria-current={locale === 'en' ? 'page' : undefined}>EN</a
            >
            <a
                href={localizedPath('es')}
                hreflang="es"
                lang="es"
                data-locale-link
                aria-current={locale === 'es' ? 'page' : undefined}>ES</a
            >
        </nav>
        <button
            class={styles.theme}
            type="button"
            data-theme-toggle
            data-to-dark={t('theme.toDark')}
            data-to-light={t('theme.toLight')}
            aria-label={t('theme.toDark')}>
            <Icon name="darkMode" class="when-dark" />
            <Icon name="lightMode" class="when-light" />
        </button>
    </div>
</header>

<script>
    import '../../scripts/theme';
    import '../../scripts/locale';
</script>
