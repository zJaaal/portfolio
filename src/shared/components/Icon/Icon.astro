---
import { ICON_PATHS, type IconName } from '../../constants';
import styles from './Icon.module.css';

interface Props {
    name: IconName;
    class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={[styles.icon, className]} viewBox="0 -960 960 960" aria-hidden="true">
    <path d={ICON_PATHS[name]}></path>
</svg>
