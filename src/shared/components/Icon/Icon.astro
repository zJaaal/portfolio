---
import { ICON_PATHS, type IconName } from '../../constants';

interface Props {
    name: IconName;
    class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 -960 960 960" aria-hidden="true">
    <path d={ICON_PATHS[name]}></path>
</svg>

<style>
    .icon {
        width: 1.25rem;
        height: 1.25rem;
        fill: currentColor;
        flex: none;
    }
</style>
