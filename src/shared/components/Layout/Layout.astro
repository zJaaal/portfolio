---
import '../../../styles/global.css';
import { LOCALES, localizedPath, useTranslations, type Locale } from '../../../i18n';
import { ARRIVING_KEY, SCROLL_KEY, THEME_STORAGE_KEY } from '../../constants';
import { personSchema } from '../../utils/person';
import { Header } from '../Header';

interface Props {
    locale: Locale;
    /** Path after the locale, e.g. "/" or "/work/artemis/". */
    path?: string;
    title?: string;
    description?: string;
}

const { locale, path = '/', title, description } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL('https://zjaaal.dev');
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(localizedPath(locale, path), site).href;
const ogImage = new URL('/og.png', site).href;
const portrait = new URL('/portrait.png', site).href;
const OG_LOCALE = { en: 'en_US', es: 'es_419' } as const;

// GEO: who this is, in a form search and AI engines read directly.
const person = personSchema({ url: new URL(localizedPath(locale), site).href, image: portrait, description: pageDescription });
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <link rel="canonical" href={canonical} />
        {
            LOCALES.map((alt) => (
                <link rel="alternate" hreflang={alt} href={new URL(localizedPath(alt, path), site).href} />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', path), site).href} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="author" content="Jalinson Diaz" />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#120C1F" />
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F4FC" />

        <meta property="og:type" content="profile" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t('meta.ogAlt')} />
        <meta property="og:locale" content={OG_LOCALE[locale]} />
        <meta property="og:site_name" content="zJaaal" />
        <meta name="twitter:card" content="summary_large_image" />

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="preload" href="/fonts/overpass-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
        <!-- The map's labels and dates are set in the mono face, right below the fold. -->
        <link rel="preload" href="/fonts/overpass-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

        <script type="application/ld+json" set:html={JSON.stringify(person)} />

        <!-- Applies the saved theme before first paint, so there is no flash. -->
        <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
            try {
                const saved = localStorage.getItem(key);
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.dataset.theme = saved;
                }
            } catch {
                /* ignoreStorageBlocked */
            }
        </script>

        <!-- How this page was reached (navigate.ts): a new page, or the same page in the other
             language. It picks the arrival (global.css), from first paint. `data-fallback` marks a
             browser without cross-document view transitions (Firefox), which animates <main> itself. -->
        <script is:inline define:vars={{ arriving: ARRIVING_KEY }}>
            try {
                const root = document.documentElement;
                const kind = sessionStorage.getItem(arriving);
                sessionStorage.removeItem(arriving);
                if (!('onpagereveal' in window)) {
                    root.dataset.fallback = '';
                }
                if (kind === 'page' || kind === 'lang') {
                    root.dataset.arriving = kind;
                }
            } catch {
                /* ignoreStorageBlocked */
            }
        </script>
    </head>
    <body>
        <Header locale={locale} path={path} />
        <slot />

        <!-- A language switch opens the other language where the visitor was, before first paint. -->
        <script is:inline define:vars={{ scroll: SCROLL_KEY }}>
            try {
                const y = sessionStorage.getItem(scroll);
                sessionStorage.removeItem(scroll);
                if (y !== null) {
                    scrollTo(0, Number(y));
                }
            } catch {
                /* ignoreStorageBlocked */
            }
        </script>
    </body>
</html>
